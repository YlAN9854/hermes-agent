  {
   "unit_id": "unit-3febc687abbe4040af70343bcd65a3de",
   "title": "Timezone Fix",
   "summary_sentences": [
    {
     "text": "User reported that observed_at displayed 2026-07-18T03:20:41 while local time was 11:20, an 8-hour difference.",
     "source_spans": [
      {
       "turn_id": "synth-c1-t026",
       "char_start": 9,
       "char_end": 80
      }
     ]
    },
    {
     "text": "Assistant identified that datetime.utcfromtimestamp produced naive UTC without timezone info, causing the offset.",
     "source_spans": [
      {
       "turn_id": "synth-c1-t028",
       "char_start": 265,
       "char_end": 329
      }
     ]
    },
    {
     "text": "Fix applied: using datetime.fromtimestamp with timezone.utc and converting to Asia/Shanghai via zoneinfo, outputting +08:00 offset.",
     "source_spans": [
      {
       "turn_id": "synth-c1-t029",
       "char_start": 150,
       "char_end": 324
      }
     ]
    },
    {
     "text": "Tests updated to expect +08:00 aware datetime, all 5 tests passed, and curl confirmed observed_at with correct local time.",
     "source_spans": [
      {
       "turn_id": "synth-c1-t032",
       "char_start": 677,
       "char_end": 719
      }
     ]
    }
   ],
