  {
   "unit_id": "unit-248c8f52b96643f68be5752cc7429efd",
   "title": "Cache unbounded growth fix",
   "summary_sentences": [
    {
     "text": "The user instructs to hunt for caches, and a grep reveals an unbounded messageCache with no deletion.",
     "source_spans": [
      {
       "turn_id": "synth-c2-t020",
       "char_start": 132,
       "char_end": 219
      },
      {
       "turn_id": "synth-c2-t021",
       "char_start": 138,
       "char_end": 260
      }
     ]
    },
    {
     "text": "The assistant implements an LRU cache capped at 50k entries with a 5‑minute TTL, controlled by environment variables.",
     "source_spans": [
      {
       "turn_id": "synth-c2-t025",
       "char_start": 33,
       "char_end": 177
      }
     ]
    },
    {
     "text": "After the fix, the load test shows the cache evicting entries but RSS still grows at ~27 MB/min.",
     "source_spans": [
      {
       "turn_id": "synth-c2-t029",
       "char_start": 89,
       "char_end": 182
      }
     ]
    }
   ],
   "covered_turns": [
    "synth-c2-t019",
    "synth-c2-t020",
    "synth-c2-t021",
    "synth-c2-t022",
    "synth-c2-t023",
    "synth-c2-t024",
    "synth-c2-t025",
