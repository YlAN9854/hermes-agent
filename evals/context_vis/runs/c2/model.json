   "created_at_turn": "synth-c2-t049"
  },
  {
   "unit_id": "unit-62de1f30d73f4ed499e70888372b1c1a",
   "title": "Final soak and CI guard",
   "summary_sentences": [
    {
     "text": "The user demands a 15‑minute soak test, which shows flat memory with only 0.02 MB/min slope and no errors.",
     "source_spans": [
      {
       "turn_id": "synth-c2-t045",
       "char_start": 354,
       "char_end": 420
      }
     ]
    },
    {
     "text": "A leak‑guard regression test is added to CI, verifying that heapUsed returns to baseline and no stray WebSocket or timeout objects remain.",
     "source_spans": [
      {
       "turn_id": "synth-c2-t047",
       "char_start": 261,
       "char_end": 320
      }
     ]
    }
   ],
   "covered_turns": [
