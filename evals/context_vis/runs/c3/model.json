  {
   "unit_id": "unit-31a1e90603e740cb82885b0c6e7c9c85",
   "title": "Maint & Privacy",
   "summary_sentences": [
    {
     "text": "The staging run fails because the cluster requires maintenance mode before bulk copy.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t022",
       "char_start": 614,
       "char_end": 733
      }
     ]
    },
    {
     "text": "The pipeline now enables maintenance mode before writing and disables it afterwards, aborting if enabling fails.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t023",
       "char_start": 59,
       "char_end": 170
      }
     ]
    },
    {
     "text": "Phone numbers must never appear in logs; they can only be stored in the access‑controlled rejects table.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t024",
       "char_start": 35,
       "char_end": 63
      }
     ]
    },
    {
     "text": "The cleaner only logs field names and failure types, and DEBUG‑level sampling masks phone columns with 138****.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t025",
       "char_start": 153,
       "char_end": 202
      }
     ]
    }
   ],
