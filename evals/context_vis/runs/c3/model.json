  {
   "unit_id": "unit-6901e56f63f14da1b4cf4ba34bf49c9e",
   "title": "Implementation",
   "summary_sentences": [
    {
     "text": "The pipeline will reuse a single connection, peaking at 1 out of the 5 limit.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t017",
       "char_start": 14,
       "char_end": 65
      }
     ]
    },
    {
     "text": "The migration file and writer.py are written, using parameterized INSERT and execute_values.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t018",
       "char_start": 527,
       "char_end": 575
      }
     ]
    }
