  {
   "unit_id": "unit-61a3d0bfdc5244b68d448b06cb908e18",
   "title": "Migration & Con",
   "summary_sentences": [
    {
     "text": "The current schema is v2, and all migrations must be run with --lock to avoid breaking the pg_partman maintenance state.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t014",
       "char_start": 175,
       "char_end": 256
      }
     ]
    },
    {
     "text": "The assistant plans to create a supplier_orders_rejects table without foreign keys, using a formal dbtool migrate --lock.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t015",
       "char_start": 83,
       "char_end": 159
      }
     ]
    },
    {
     "text": "Only 5 database connections are allowed; exceeding them causes a silent firewall drop.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t016",
       "char_start": 22,
       "char_end": 60
      }
     ]
    }
   ],
   "covered_turns": [
    "synth-c3-t014",
    "synth-c3-t015",
    "synth-c3-t016"
   ],
   "salient_infos": [
