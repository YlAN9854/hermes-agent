  {
   "unit_id": "unit-a09f473628e34d5fa7cfdd55421bb72b",
   "title": "Schema Rules",
   "summary_sentences": [
    {
     "text": "The existing supplier_orders columns must keep their names and types to avoid breaking a downstream financial report script.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t008",
