   "created_at_turn": "synth-c3-t035"
  },
  {
   "unit_id": "unit-9ccec984e334417292a598335cff5013",
   "title": "Param & Deps",
   "summary_sentences": [
    {
     "text": "All SQL must use parameterized queries, including read statements, due to a security audit requirement.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t010",
       "char_start": 28,
       "char_end": 66
      }
     ]
    },
    {
     "text": "The assistant confirms that psycopg2's parameter binding will be used everywhere, with no SQL string concatenation.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t011",
       "char_start": 52,
       "char_end": 112
      }
     ]
    },
    {
     "text": "No new third-party dependencies are allowed; only stdlib and the existing psycopg2 can be used.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t012",
       "char_start": 45,
       "char_end": 88
      }
     ]
    },
    {
     "text": "The cleaning layer will use pure stdlib with decimal.Decimal for amounts and generator batches of 5000 rows.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t013",
       "char_start": 41,
       "char_end": 114
      }
     ]
    }
   ],
   "covered_turns": [
    "synth-c3-t010",
    "synth-c3-t011",
    "synth-c3-t012",
    "synth-c3-t013"
   ],
   "salient_infos": [
    {
     "info_id": "info-b08c9b82c0b14cc28f4f392c612c4983",
     "kind": "user_stated_constraint",
     "detected_text": "写库那块补一条硬要求：我们上季度刚过安全审计，所有 SQL 必须使用参数化查询，包括你查重、查表是否存在这种只读语句也一样，审计工具会扫代码里的字符串拼接。",
     "span_in_B": {
      "turn_id": "synth-c3-t010",
      "char_start": 5,
      "char_end": 83
     },
     "status_in_A": "unknown",
     "reframed_text_in_A": null,
     "confidence": "reliable"
    },
    {
     "info_id": "info-b6220127441949da924451da0bc0488d",
     "kind": "user_stated_constraint",
     "detected_text": "这台 runner 的环境是运维用镜像锁死的，装包要走两周的审批流程，这次重构禁止引入新的第三方依赖，psycopg2 是现成的可以用，其他的一律标准库解决。",
     "span_in_B": {
      "turn_id": "synth-c3-t012",
      "char_start": 10,
      "char_end": 89
     },
     "status_in_A": "unknown",
     "reframed_text_in_A": null,
     "confidence": "reliable"
    }
   ],
