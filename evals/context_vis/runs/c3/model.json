  {
   "unit_id": "unit-fb415a9701644a24b05410f0d2b69f64",
   "title": "Design and Constraints…",
   "summary_sentences": [
    {
     "text": "User clarifies that supplier_orders columns cannot be changed, only added.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t008",
       "char_start": 96,
       "char_end": 118
      }
     ]
    },
    {
     "text": "Assistant proposes a modular plan with rejects table, bulk insert, and dataclasses.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t009",
       "char_start": 58,
       "char_end": 173
      }
     ]
    },
    {
     "text": "User mandates all SQL parameterized due to security audit.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t010",
       "char_start": 28,
       "char_end": 44
      }
     ]
    },
    {
     "text": "User forbids new third‑party packages; only standard library and psycopg2 allowed.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t012",
       "char_start": 45,
       "char_end": 88
      }
     ]
    },
    {
     "text": "Assistant adapts the plan to use standard‑library cleaning and batched generators.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t013",
       "char_start": 41,
       "char_end": 147
      }
     ]
    },
    {
     "text": "User approves final plan and adds a 5‑connection database limit.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t016",
       "char_start": 0,
       "char_end": 43
      }
     ]
    }
   ],
