  },
  {
   "unit_id": "unit-820aadf3610a4055aec8cecffcea0951",
   "title": "Architecture & Schema Design",
   "summary_sentences": [
    {
     "text": "Assistant proposes splitting into reader, cleaner, writer, pipeline, and adding a rejects table.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t009",
       "char_start": 61,
       "char_end": 173
      }
     ]
    },
    {
     "text": "User requires all SQL to use parameterized queries.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t010",
       "char_start": 28,
       "char_end": 66
      }
     ]
    },
    {
     "text": "Assistant suggests using pandas for cleaning.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t011",
       "char_start": 147,
       "char_end": 169
      }
     ]
    },
    {
     "text": "User rejects pandas because dependency addition requires lengthy approval; only stdlib and psycopg2 allowed.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t012",
       "char_start": 0,
       "char_end": 89
      }
     ]
    },
    {
     "text": "Assistant commits to pure standard library cleaning with csv.stream and decimal.Decimal.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t013",
       "char_start": 41,
       "char_end": 120
      }
     ]
    },
    {
     "text": "The database is at schema v2 and the supplier_orders table lists columns order_date, vendor_code, sku, amount, vendor_name, contact_ph, batch_id, loaded_at.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t014",
       "char_start": 103,
       "char_end": 149
      },
      {
       "turn_id": "synth-c3-t014",
       "char_start": 480,
       "char_end": 835
      }
     ]
    },
    {
     "text": "The dbtool warns to always migrate with --lock to avoid corrupting pg_partman maintenance state.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t014",
       "char_start": 175,
       "char_end": 345
      }
     ]
    },
    {
     "text": "The rejects table will have id, source_file, line_no, raw_line, reason, created_at, no foreign key to main table.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t015",
       "char_start": 170,
       "char_end": 242
      }
     ]
    },
    {
     "text": "User warns max 5 database connections, exceeding causes silent firewall blocks.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t016",
       "char_start": 22,
       "char_end": 60
      }
     ]
    },
    {
     "text": "Assistant decides to use a single connection with no pool.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t017",
       "char_start": 3,
       "char_end": 31
      }
     ]
    },
    {
     "text": "Migration file adds supplier_orders_rejects table with bigserial id and index on source_file.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t018",
       "char_start": 100,
       "char_end": 483
      }
     ]
    },
    {
     "text": "Writer module implements parameterized batch insert with execute_values and documents no SQL concatenation rule.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t018",
       "char_start": 527,
       "char_end": 575
      }
     ]
    }
   ],
   "covered_turns": [
