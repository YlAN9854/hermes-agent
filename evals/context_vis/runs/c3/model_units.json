  {
   "unit_id": "unit-b7a2f3607db24a6b9712c01a83ab3878",
   "title": "Staging & Cron Configuration",
   "summary_sentences": [
    {
     "text": "Assistant suggests using utf-8 with replace for encoding.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t019",
       "char_start": 93,
       "char_end": 133
      }
     ]
    },
    {
     "text": "User objects that sniff_encoding must be preserved to avoid garbled Chinese names in GBK files.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t020",
       "char_start": 10,
       "char_end": 82
      }
     ]
    },
    {
     "text": "Assistant copies sniff_encoding into reader.py unchanged.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t021",
       "char_start": 53,
       "char_end": 108
      }
     ]
    },
    {
     "text": "Staging test fails because server requires maintenance mode for bulk import.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t022",
       "char_start": 538,
       "char_end": 603
      }
     ]
    },
    {
     "text": "Assistant plans to toggle maintenance mode with ops-cli.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t023",
       "char_start": 59,
       "char_end": 170
      }
     ]
    },
    {
     "text": "User forbids printing phone numbers in logs.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t024",
       "char_start": 35,
       "char_end": 49
      }
     ]
    },
    {
     "text": "Assistant logs only reject reasons, stores raw lines only in rejects table, and masks phone numbers in debug logs.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t025",
       "char_start": 16,
       "char_end": 203
      }
     ]
    },
    {
     "text": "Staging test loads 4982 rows, 18 rejects, row count check passes, and uses only 1 database connection.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t026",
       "char_start": 955,
       "char_end": 1010
      },
      {
       "turn_id": "synth-c3-t026",
       "char_start": 1055,
       "char_end": 1076
      }
     ]
    },
    {
     "text": "GB18030 file was correctly decoded and Chinese vendor names remain intact.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t027",
       "char_start": 23,
       "char_end": 51
      }
     ]
    },
    {
     "text": "User rejects 02:30 cron due to backup window and instructs scheduling after 04:30.",
     "source_spans": [
      {
       "turn_id": "synth-c3-t028",
       "char_start": 21,
       "char_end": 88
      }
     ]
    }
   ],
