   "created_at_turn": "synth-c4-t035"
  },
  {
   "unit_id": "unit-2f070bfdf7184ad89ee1ae44b2f2f069",
   "title": "Migration Plan",
   "summary_sentences": [
    {
     "text": "User requests a detailed migration plan covering workflow split, matrix design, and secrets handling.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t011",
       "char_start": 0,
       "char_end": 55
      }
     ]
    },
    {
     "text": "Assistant proposes three workflows: build.yml (matrix over 12 packages), test.yml (4 shard junit), deploy.yml (main triggered by test success with environment approval for production), plus deferred nightly-e2e; cache uses pnpm store and turbo local.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t012",
       "char_start": 0,
       "char_end": 405
      }
     ]
    },
    {
     "text": "User mandates that all secrets must use GitHub Environments, not workflow files or repo-level secrets, and approval by platform-leads.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t013",
       "char_start": 0,
       "char_end": 115
      }
     ]
    },
    {
     "text": "Assistant confirms environment-scoped secrets only: staging no approval, production required reviewers set to platform-leads team, kubeconfig stored as base64 environment secret, and audit trail via environment deployment log.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t014",
       "char_start": 0,
       "char_end": 275
      }
     ]
    }
   ],
   "covered_turns": [
