  {
   "unit_id": "unit-fdc5ed0a8f354f2982a42def4354253e",
   "title": "Build Iteration",
   "summary_sentences": [
    {
     "text": "Assistant writes first version of build.yml with checkout, Node 20, pnpm install, and a matrix over 12 packages for build and typecheck.",
