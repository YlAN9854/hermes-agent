  {
   "unit_id": "unit-60e8c16b86c245dda26091b320c9508b",
   "title": "ConcurrencyDoc",
   "summary_sentences": [
    {
     "text": "User asks whether the 12-package matrix will exhaust the organization's limited runner concurrency.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t015",
       "char_start": 0,
       "char_end": 41
      }
     ]
    },
    {
     "text": "Assistant sets max-parallel: 4 and cancel-in-progress: true to control parallelism and prevent job pileup, with overall time far faster than Jenkins serial build.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t016",
       "char_start": 14,
       "char_end": 175
      }
     ]
    },
    {
     "text": "Migration plan document is created: workflows (build, test, deploy), four milestones (M1 build, M2 test, M3 deploy rehearsal, M4 parallel run/decommission), secrets in GitHub Environments, caching via pnpm store and turbo local cache.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t017",
       "char_start": 0,
       "char_end": 948
      }
     ]
    },
    {
     "text": "Assistant confirms plan saved to docs/ci-migration-plan.md with four milestones, nightly-e2e explicitly deferred.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t018",
       "char_start": 0,
       "char_end": 72
      }
     ]
    }
