  {
   "unit_id": "unit-df6c88dcf34e408bbe653edaf395e459",
   "title": "部署工作流迁移与验证",
   "summary_sentences": [
    {
     "text": "The user mandated manual approval for production deployment, using platform-leads as reviewers.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t050",
       "char_start": 19,
       "char_end": 71
      }
     ]
    },
    {
     "text": "The assistant designed a workflow with automatic staging and production requiring environment approval, mirroring Jenkins input gate.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t051",
       "char_start": 0,
       "char_end": 231
      }
     ]
    },
    {
     "text": "The deploy workflow YAML defined a staging job and a production job with an environment that has required reviewers.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t052",
       "char_start": 631,
       "char_end": 769
      }
     ]
    },
    {
     "text": "The assistant stated that environments and secrets need to be configured.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t053",
       "char_start": 0,
       "char_end": 73
      }
     ]
    },
    {
     "text": "The production environment was configured with platform-leads as required reviewers, while staging had no protection rules.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t054",
       "char_start": 318,
       "char_end": 407
      },
      {
       "turn_id": "synth-c4-t054",
       "char_start": 106,
       "char_end": 129
      }
     ]
    },
    {
     "text": "Environment-scoped secrets KUBECONFIG_STAGING and KUBECONFIG_PROD were set.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t054",
       "char_start": 583,
       "char_end": 667
      },
      {
       "turn_id": "synth-c4-t054",
       "char_start": 739,
       "char_end": 823
      }
     ]
    },
    {
     "text": "After environment setup, assistant confirmed environments ready and planned a staging deploy verification.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t055",
       "char_start": 20,
       "char_end": 96
      }
     ]
    },
    {
     "text": "The staging deploy rolled out all four services successfully, with smoke tests returning 200.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t056",
       "char_start": 412,
       "char_end": 548
      }
     ]
    },
    {
     "text": "The staging deployment completed in 4 minutes 18 seconds.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t056",
       "char_start": 2256,
       "char_end": 2274
      }
     ]
    },
    {
     "text": "Assistant confirmed staging deploy success and that production is awaiting approval.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t057",
       "char_start": 0,
       "char_end": 71
      }
     ]
    },
    {
     "text": "User requested a production rehearsal on the staging-canary namespace without touching real production.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t058",
       "char_start": 0,
       "char_end": 51
      }
     ]
    },
    {
     "text": "The canary deployment passed all smoke checks (26/26) within the staging-canary namespace.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t059",
       "char_start": 532,
       "char_end": 575
      }
     ]
    },
    {
     "text": "The approval gate required platform-leads review and was approved after 3 minutes 12 seconds.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t059",
       "char_start": 728,
       "char_end": 789
      }
     ]
    },
    {
     "text": "The rehearsal completed without touching any resources outside the staging-canary namespace.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t059",
       "char_start": 821,
       "char_end": 902
      }
     ]
    },
    {
     "text": "Assistant concluded the canary rehearsal replicated the Jenkins input approval gate, marking M3 complete.",
     "source_spans": [
      {
       "turn_id": "synth-c4-t060",
       "char_start": 92,
       "char_end": 127
      }
     ]
    }
   ],
